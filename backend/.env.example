# Copy to .env for local development. NEVER commit .env (Section 4.5).

# --- App ---
APP_ENV=local                                  # local | staging | production | test
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]         # JSON list of allowed frontend origins

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-me                 # Project settings > API > JWT secret
DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Google Document AI ---
GCP_PROJECT_ID=your-gcp-project
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=replace-me                  # Form Parser processor ID
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json   # file stays in gitignored secrets/

# --- LLM (pin exact model ID; change only via PR with eval results) ---
ANTHROPIC_API_KEY=sk-ant-replace-me
LLM_MODEL_ID=replace-with-pinned-model-id

# --- Retrieval ---
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=replace-me
COHERE_API_KEY=replace-me
RERANK_MIN_SCORE=0.30

# --- Validation rules ---
MIN_MONTHLY_WAGE_LKR=0                         # set from current law before demo (R07)
MAX_WEEKLY_HOURS=60

# --- Feature flags ---
FEATURE_EXPORT_XLSX=false
FEATURE_REPLAY_MODE=false

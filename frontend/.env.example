# Copy to .env.local. Only VITE_* variables reach the browser: never put secrets here.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me          # public anon key only, never the service role key

# Feature flags (Section 4.6)
VITE_FEATURE_EXPORT_XLSX=false
